#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@kicksecure.com>
## See the file COPYING for copying conditions.

## AI-Assisted

## Thin CLI wrapper for journal-maker: resolve the python modules (co-located
## dev tree first, else the installed /usr/share path) and dispatch to
## jmaker.cli.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

script_dir="$(dirname -- "$(readlink --canonicalize -- "$0")")"

moddir=""
for cand in "${script_dir}/../share/journal-maker" "/usr/share/journal-maker"; do
   if [ -d "${cand}/jmaker" ]; then
      moddir="${cand}"
      break
   fi
done

if [ -z "${moddir}" ]; then
   printf '%s\n' "journal-maker: python modules not found" >&2
   exit 1
fi

export PYTHONPATH="${moddir}${PYTHONPATH:+:${PYTHONPATH}}"
python3 -Bsu -m jmaker.cli "$@"
